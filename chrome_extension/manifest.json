{
  "manifest_version": 3,
  "name": "Applyr Job Extractor",
  "version": "1.1",
  "description": "Extract job posting details for Applyr",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup/popup.html"
  }
}
