{
  "manifest_version": 3,
  "name": "Applyr Job Extractor",
  "version": "1.0",
  "description": "Extract job posting details for Applyr",
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["<all_urls>"],

  "background": {
    "service_worker": "background.js"
  },

  "action": {
    "default_popup": "popup/popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ]
}